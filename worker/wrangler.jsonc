{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fenegroni-intake",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "fenegroni.com/api/intake", "zone_name": "fenegroni.com" },
    { "pattern": "fenegroni.com/api/rates", "zone_name": "fenegroni.com" },
    { "pattern": "fenegroni.com/api/newsletter", "zone_name": "fenegroni.com" }
  ],
  "vars": {
    "FROM_ADDRESS": "form@fenegroni.com",
    "ALLOWED_ORIGINS": "https://fenegroni.com"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "observability": { "enabled": true }
}
